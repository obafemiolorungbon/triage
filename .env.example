# Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:15432/triage

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# API
PORT=4200
APP_URL=http://localhost:3000
# Optional: comma-separated browser origins (overrides default CORS list from APP_URL)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_PUBLIC_URL=http://localhost:4200
BETTER_AUTH_URL=http://localhost:4200
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32-min-32-chars

# OpenRouter (optional in dev — worker uses fallback triage when empty)
OPENROUTER_API_KEY=
OPENROUTER_MODEL_FILTER=openai/gpt-4o-mini
OPENROUTER_MODEL_MAIN=openai/gpt-4o
OPENROUTER_MODEL_EMBEDDING=openai/text-embedding-3-small
# Optional short blurb about your product/industry that is inlined into the
# triage prompt (e.g. "a B2B billing SaaS for small retailers"). When empty,
# the triage prompt falls back to a generic SaaS support framing.
OPENROUTER_INDUSTRY_CONTEXT=

# Email (optional)
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Slack urgent alerts (optional)
SLACK_WEBHOOK_URL=

# External issue providers (optional)
LINEAR_API_KEY=
LINEAR_TEAM_ID=
LINEAR_PROJECT_ID=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task

# Image attachments (S3-compatible; docker-compose uses MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=triage-uploads
S3_FORCE_PATH_STYLE=true

# Bull Board — queue dashboard at http://localhost:4200/admin/queues (optional)
# BULL_BOARD_ENABLED=true
# BULL_BOARD_USER=admin
# BULL_BOARD_PASSWORD=change-me

# Next.js (flux)
NEXT_PUBLIC_API_URL=http://localhost:4200
INTERNAL_API_URL=http://localhost:4200
NEXT_PUBLIC_ENABLE_WS=false

# Widget playground
NEXT_PUBLIC_WIDGET_ORIGIN=http://localhost:3000
NEXT_PUBLIC_WIDGET_KEY=local-dev-widget
