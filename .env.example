# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/triage

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# API
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:4200
API_PUBLIC_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32-min-32-chars

# OpenRouter (optional in dev — worker uses fallback triage when empty)
OPENROUTER_API_KEY=
OPENROUTER_MODEL_FILTER=openai/gpt-4o-mini
OPENROUTER_MODEL_MAIN=openai/gpt-4o

# Email (optional)
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Slack urgent alerts (optional)
SLACK_WEBHOOK_URL=

# Next.js (flux)
NEXT_PUBLIC_API_URL=http://localhost:3000
INTERNAL_API_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_WS=false
