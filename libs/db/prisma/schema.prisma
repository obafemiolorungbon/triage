generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  role          String    @default("agent")

  sessions         Session[]
  accounts         Account[]
  comments         Comment[]
  auditLogs        AuditLog[]
  assignedFeedback Feedback[] @relation("AssignedFeedback")
  notifications    Notification[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

enum EscalationTier {
  none
  watch
  expedite
  critical
}

enum EscalationOperator {
  equals
  contains
  exists
  numeric_gte
}

enum ExternalIssueProvider {
  linear
  jira
}

enum ExternalIssueCreationMode {
  manual
  automatic
}

enum AttachmentKind {
  image
}

enum WidgetSubmissionType {
  bug
  idea
  question
  praise
  custom
}

enum SurveyMode {
  none
  csat
  nps
  thumbs
}

enum SurveyScale {
  csat_5
  nps_10
  thumbs
}

enum WidgetFieldKind {
  text
  textarea
  email
  url
  number
  select
  multiselect
  radio
  checkbox
  rating
  file
}

enum WidgetFieldTarget {
  user
  metadata
  message
  title
  category
  severity
}

enum FeedbackSeverity {
  low
  medium
  high
  critical
}

enum DeflectionOutcome {
  searched
  answered
  solved
  submitted
  abandoned
}

enum FeedbackSentiment {
  negative
  neutral
  positive
}

enum FeedbackStatus {
  new
  triaged
  claimed
  in_progress
  resolved
  rejected
}

model Feedback {
  id              String             @id @default(cuid())
  shortId         String             @unique
  widgetId        String?
  widget          Widget?            @relation(fields: [widgetId], references: [id], onDelete: SetNull)
  submitterEmail  String
  rawText         String             @db.Text
  cleanedText     String?            @db.Text
  submissionType  WidgetSubmissionType?
  category        String?
  severity        FeedbackSeverity?
  escalationTier  EscalationTier     @default(none)
  escalationReason String?
  sentiment       FeedbackSentiment?
  status          FeedbackStatus     @default(new)
  isNoise         Boolean            @default(false)
  knowledgeGap    Boolean            @default(false)
  userContext     Json?
  metadata        Json?
  consent         Json?
  sourceUrl       String?
  sourceTitle     String?
  assignedAgentId String?
  assignedAgent   User?              @relation("AssignedFeedback", fields: [assignedAgentId], references: [id])
  createdAt       DateTime           @default(now())
  triagedAt       DateTime?
  resolvedAt      DateTime?

  comments           Comment[]
  auditLogs          AuditLog[]
  triageRuns         FeedbackTriageRun[]
  externalIssueLinks ExternalIssueLink[]
  attachments        Attachment[]
  surveys            Survey[]

  @@index([status, escalationTier, createdAt])
  @@index([assignedAgentId])
  @@index([widgetId])
  @@map("feedback")
}

/**
 * Immutable record of one main-model triage run for a feedback item. The
 * denormalised fields on `Feedback` always mirror the latest row here so
 * list/Kanban queries stay cheap, while this table keeps a full audit trail
 * (prompt inputs + model output) for reproducibility and re-triage.
 */
model FeedbackTriageRun {
  id              String             @id @default(cuid())
  feedbackId      String
  feedback        Feedback           @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  model           String
  cleanedText     String             @db.Text
  category        String
  sentiment       FeedbackSentiment
  knowledgeGap    Boolean
  suggestedTags   String[]
  escalationTier  EscalationTier     @default(none)
  escalationReason String?
  issueTitle      String?
  issueBody       String?            @db.Text
  industryContext String?            @db.Text
  createdAt       DateTime           @default(now())

  @@index([feedbackId, createdAt])
  @@map("feedback_triage_run")
}

model Comment {
  id         String   @id @default(cuid())
  feedbackId String
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body       String   @db.Text
  createdAt  DateTime @default(now())

  @@index([feedbackId])
  @@map("feedback_comment")
}

model AuditLog {
  id         String    @id @default(cuid())
  actorId    String?
  actor      User?     @relation(fields: [actorId], references: [id])
  feedbackId String?
  feedback   Feedback? @relation(fields: [feedbackId], references: [id], onDelete: SetNull)
  action     String
  before     Json?
  after      Json?
  createdAt  DateTime  @default(now())

  @@index([feedbackId])
  @@map("audit_log")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@map("notification")
}

model Tenant {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  industryPrompt String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("tenant")
}

model IntegrationConfig {
  id        String   @id @default(cuid())
  provider  String
  tenantId  String?
  config    Json
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("integration_config")
}

model Workspace {
  id                 String                @id @default(cuid())
  slug               String                @unique
  companyName        String                @default("Your company")
  productDescription String                @default("")
  industry           String                @default("general SaaS")
  supportContext     String                @default("")
  escalationGuidance String                @default("")
  aiContextNotes     String                @default("")
  autoCreateCritical Boolean               @default(false)
  autoCreateProvider ExternalIssueProvider @default(linear)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  widgets    Widget[]
  kbArticles KbArticle[]
  kbChunks   KbChunk[]
  deflections Deflection[]

  @@map("workspace")
}

model Widget {
  id                  String       @id @default(cuid())
  workspaceId         String
  workspace           Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name                String
  widgetKey           String       @unique @default(cuid())
  widgetSecret        String       @default(cuid())
  archivedAt          DateTime?
  allowedOrigins      String[]     @default([])
  devMode             Boolean      @default(false)
  identityVerificationRequired Boolean @default(false)
  rateLimitPerMinute  Int          @default(30)
  configRateLimitPerMinute Int     @default(120)
  requireConsent      Boolean      @default(false)
  privacyPolicyUrl    String?
  consentText         String       @default("I agree to be contacted about this feedback.")
  brandColor          String       @default("#D9FF4D")
  accentColor         String       @default("#0A0A0B")
  position            String       @default("bottom-right")
  size                String       @default("md")
  title               String       @default("Send feedback")
  description         String       @default("Tell us what happened or what could be better.")
  successMessage      String       @default("Thanks. Your feedback was received.")
  enabledUserFields   String[]     @default(["email", "name"])
  requiredUserFields  String[]     @default(["email"])
  enabledMetadataKeys String[]     @default(["plan", "environment", "accountId", "url"])
  maxAttachmentBytes  Int          @default(10485760)
  allowedMimeTypes    String[]     @default(["image/png", "image/jpeg", "image/webp"])
  maxAttachmentsPerSubmit Int      @default(3)
  enabledTypes        WidgetSubmissionType[] @default([bug, idea, question])
  surveyMode          SurveyMode             @default(none)
  pageRules           Json?
  audienceRules       Json?
  triggerConfig       Json?
  inlineEnabled       Boolean                @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  theme       WidgetTheme?
  fields      WidgetField[]
  variants    WidgetVariant[]
  feedback    Feedback[]
  attachments Attachment[]
  surveys     Survey[]
  deflections Deflection[]

  @@unique([workspaceId, name])
  @@index([workspaceId, archivedAt])
  @@map("widget")
}

model WidgetVariant {
  id            String   @id @default(cuid())
  widgetId      String
  widget        Widget   @relation(fields: [widgetId], references: [id], onDelete: Cascade)
  name          String
  weight        Int      @default(100)
  brandColor    String?
  launcherLabel String?
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([widgetId, enabled])
  @@map("widget_variant")
}

model KbArticle {
  id              String   @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  slug            String
  title           String
  body            String   @db.Text
  published       Boolean  @default(false)
  sourceProvider  String?
  sourceId        String?
  sourceUrl       String?
  sourceLocale    String?
  sourceUpdatedAt DateTime?
  sourcePath      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  chunks      KbChunk[]

  @@unique([workspaceId, slug])
  @@unique([workspaceId, sourceProvider, sourceId])
  @@index([workspaceId, published])
  @@map("kb_article")
}

model KbChunk {
  id          String   @id @default(cuid())
  articleId   String
  article     KbArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  heading     String?
  body        String   @db.Text
  embedding   Unsupported("vector(1536)")?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([articleId])
  @@index([workspaceId])
  @@map("kb_chunk")
}

model Deflection {
  id          String            @id @default(cuid())
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  widgetId    String?
  widget      Widget?           @relation(fields: [widgetId], references: [id], onDelete: SetNull)
  query       String            @db.Text
  outcome     DeflectionOutcome
  articleId   String?
  score       Float?
  metadata    Json?
  createdAt   DateTime          @default(now())

  @@index([workspaceId, createdAt])
  @@index([widgetId, outcome])
  @@map("deflection")
}

model WidgetTheme {
  id           String   @id @default(cuid())
  widgetId     String   @unique
  widget       Widget   @relation(fields: [widgetId], references: [id], onDelete: Cascade)
  logoUrl      String?
  surfaceColor String   @default("#0A0A0B")
  textColor    String   @default("#FAF7F1")
  fontFamily   String   @default("system")
  borderRadius String   @default("18px")
  shadow       String   @default("soft")
  launcherIcon String   @default("message-circle")
  launcherLabel String  @default("Feedback")
  darkMode     String   @default("auto")
  poweredBy    Boolean  @default(true)
  successAnimation String @default("check")
  customCss    String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("widget_theme")
}

model WidgetField {
  id          String            @id @default(cuid())
  widgetId    String
  widget      Widget            @relation(fields: [widgetId], references: [id], onDelete: Cascade)
  key         String
  label       String
  kind        WidgetFieldKind
  required    Boolean           @default(false)
  placeholder String?
  helpText    String?
  validation  Json?
  options     Json?
  visibleWhen Json?
  target      WidgetFieldTarget @default(metadata)
  order       Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([widgetId, key])
  @@index([widgetId, order])
  @@map("widget_field")
}

model Attachment {
  id         String         @id @default(cuid())
  feedbackId String
  feedback   Feedback       @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  widgetId   String
  widget     Widget         @relation(fields: [widgetId], references: [id], onDelete: Cascade)
  kind       AttachmentKind @default(image)
  mimeType   String
  fileName   String?
  sizeBytes  Int
  storageKey String         @unique
  width      Int?
  height     Int?
  createdAt  DateTime       @default(now())

  @@index([feedbackId])
  @@index([widgetId])
  @@map("attachment")
}

model Survey {
  id         String      @id @default(cuid())
  feedbackId String?
  feedback   Feedback?   @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  widgetId   String
  widget     Widget      @relation(fields: [widgetId], references: [id], onDelete: Cascade)
  score      Int
  scale      SurveyScale
  comment    String?     @db.Text
  createdAt  DateTime    @default(now())

  @@index([feedbackId])
  @@index([widgetId, createdAt])
  @@map("survey")
}

model EscalationRule {
  id        String             @id @default(cuid())
  label     String
  field     String
  operator  EscalationOperator
  value     String?
  tier      EscalationTier
  reason    String
  enabled   Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([enabled, tier])
  @@map("escalation_rule")
}

model ExternalIssueLink {
  id           String                    @id @default(cuid())
  feedbackId   String
  feedback     Feedback                  @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  provider     ExternalIssueProvider
  externalId   String
  externalKey  String?
  externalUrl  String
  creationMode ExternalIssueCreationMode
  createdAt    DateTime                  @default(now())

  @@unique([feedbackId, provider])
  @@index([provider, externalId])
  @@map("external_issue_link")
}
